{
  "name": "@tobias.istvan/dev",
  "version": "0.0.0",
  "description": "Set up a workspace around a code repository, and gather the tickets, docs and designs each task needs, for people and AI agents",
  "license": "MIT",
  "author": "Istvan Tobias",
  "type": "module",
  "bin": {
    "dev": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc && node -e \"require('node:fs').chmodSync('dist/cli.js',0o755)\"",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.5",
    "cheerio": "^1.2.0",
    "commander": "^15.1.0",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/turndown": "^5.0.6",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
