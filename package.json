{
  "name": "@tobias.istvan/dev",
  "version": "0.3.0-alpha.1",
  "description": "Set up a workspace around a code repository, and gather the tickets, docs and designs each task needs, for people and AI agents",
  "license": "MIT",
  "author": "Istvan Tobias",
  "type": "module",
  "bin": {
    "dev": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc && node -e \"require('node:fs').chmodSync('dist/cli.js',0o755)\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "node --experimental-strip-types --import ./test/setup.ts --test --test-timeout=120000 \"test/**/*.test.ts\"",
    "prepack": "npm run build",
    "test:package": "node --experimental-strip-types test/package-smoke.ts"
  },
  "dependencies": {
    "@inquirer/core": "^12.0.6",
    "@inquirer/prompts": "^8.7.5",
    "commander": "^15.1.0",
    "css-select": "^7.0.0",
    "dom-serializer": "^3.1.1",
    "domhandler": "^6.0.1",
    "domutils": "^4.0.2",
    "htmlparser2": "^12.0.0",
    "ink": "^8.0.0",
    "react": "^19.3.1",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
